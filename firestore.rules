rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One document per user holding their progress. Only the signed-in owner can touch it.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validProgress() {
        let d = request.resource.data;
        return d.keys().hasOnly(['done', 'updatedAt'])
          && d.keys().hasAll(['done', 'updatedAt'])
          && d.done is map
          && d.done.size() <= 1000
          && d.updatedAt is string
          && d.updatedAt.size() <= 40;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validProgress();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
